{
  "schema_version": 2,
  "project": "Sayuri Yukishiro",
  "repository": "Aspksa/Sayuri-Yukishiro",
  "version": "0.4.0",
  "development_version": "0.5.0",
  "core_version": "0.3.0",
  "stage": "module-runtime",
  "status": "completed",
  "platform": {
    "primary": "Windows",
    "portable_paths": true,
    "default_host": "127.0.0.1",
    "default_port": 8765
  },
  "foundation": {
    "launcher": "Sayuri-Yukishiro.bat -> scripts/launcher.ps1",
    "tray": "Windows Forms NotifyIcon",
    "web_shell": "Python standard library HTTP server",
    "core_database": "data/core/sayuri_yukishiro.db",
    "module_databases": "data/modules/<module_id>.db",
    "auto_update": "configured upstream + fast-forward only when worktree is clean",
    "data_directory": "project data/ by default; SAYURI_DATA_DIR may relocate runtime data",
    "module_sources": "project modules/ by default; SAYURI_MODULES_DIR may add directories"
  },
  "update_protocol": {
    "required": true,
    "protocol": "docs/UPDATE_PROTOCOL.md",
    "journal": "UPDATE_LOG.md",
    "id_registry": "UPDATE_IDS.json",
    "agent_entrypoint": "AGENTS.md",
    "validator": "scripts/validate_update_protocol.py",
    "sequence": "task -> ID -> change -> check -> version -> journal -> commit -> next_action"
  },
  "versioning_policy": {
    "project_version": "SemVer",
    "rule": "Every released project change increments the project version.",
    "module_versions": "Each module owns an independent SemVer version."
  },
  "safety": {
    "no_hardcoded_drive_letter": true,
    "no_forced_git_reset": true,
    "no_update_over_local_changes": true,
    "bind_localhost_only": true,
    "graceful_shutdown": "localhost tokenized POST /api/shutdown with Kill fallback only after timeout",
    "sqlite_journal_policy": "WAL on safe local storage; DELETE on OneDrive/network/removable storage"
  },
  "next_action": "v0.5.0 Action Broker: implement explicit approval and safe execution of MUTATION and EXTERNAL capabilities, extended module permission grants, and an audit trail of executed actions.",
  "system_core": {
    "version": "0.3.0",
    "services": [
      "configuration",
      "logging",
      "event_bus",
      "job_manager",
      "checkpoints",
      "recovery"
    ],
    "database_schema": 4,
    "api": "CoreAPI",
    "recovery_policy": "restore context and next_action without automatic replay of arbitrary actions",
    "job_history_limit": 500,
    "health_policy": "lightweight polling; SQLite quick_check only on deep diagnostics"
  },
  "cognitive_core_version": "0.3.1",
  "cognitive_core": {
    "version": "0.3.1",
    "layers": [
      "context",
      "intent",
      "goals",
      "planner",
      "capability_registry",
      "execution_gate",
      "evidence",
      "verification",
      "assessment",
      "provider_interface"
    ],
    "provider_interface": "ReasoningProvider",
    "default_provider": "NullReasoningProvider",
    "database_schema": 3,
    "persistence": [
      "cognitive_sessions",
      "cognitive_receipts"
    ],
    "safety_boundary": {
      "read_only": "allowed",
      "mutation": "requires_action_broker",
      "external": "requires_action_broker"
    },
    "recovery": "system-core checkpoints with exact next_action",
    "api": [
      "/api/cognitive",
      "/api/cognitive/sessions"
    ],
    "capability_sources": [
      "cognitive_builtin",
      "module_runtime"
    ]
  },
  "module_runtime_version": "0.4.0",
  "module_runtime": {
    "version": "0.4.0",
    "manifest": "modules/<module_id>/module.json",
    "manifest_version": 1,
    "layers": [
      "discovery",
      "manifest_validation",
      "dependency_graph",
      "permission_broker",
      "module_migrations",
      "lifecycle",
      "health",
      "capability_registration"
    ],
    "module_states": [
      "discovered",
      "disabled",
      "rejected",
      "blocked",
      "loaded",
      "migrated",
      "running",
      "stopped",
      "failed"
    ],
    "database_schema": 4,
    "persistence": [
      "module_states",
      "module_migrations"
    ],
    "auto_granted_permissions": [
      "core.config.read",
      "core.events.publish",
      "core.jobs.submit",
      "core.checkpoints.write",
      "module.database"
    ],
    "blocked_permissions": [
      "system.process",
      "network.outbound",
      "filesystem.write"
    ],
    "capability_namespace": "module.<module_id>.<name>",
    "failure_policy": "isolate failed module, block dependents, save checkpoint with next_action; modules.strict_startup rolls back every started module",
    "bundled_modules": [
      "system_probe"
    ],
    "api": [
      "/api/modules",
      "/api/modules/runtime",
      "/api/modules/health",
      "/api/modules/states"
    ]
  }
}
