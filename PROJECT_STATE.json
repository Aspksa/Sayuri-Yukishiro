{
  "schema_version": 2,
  "project": "Sayuri Yukishiro",
  "repository": "Aspksa/Sayuri-Yukishiro",
  "version": "0.1.0",
  "development_version": "0.1.1",
  "core_version": "0.1.0",
  "stage": "update-governance",
  "status": "in_progress",
  "platform": {
    "primary": "Windows",
    "portable_paths": true,
    "default_host": "127.0.0.1",
    "default_port": 8765
  },
  "foundation": {
    "launcher": "Sayuri-Yukishiro.bat -> scripts/launcher.ps1",
    "tray": "Windows Forms NotifyIcon",
    "web_shell": "Python standard library HTTP server",
    "core_database": "data/core/sayuri_yukishiro.db",
    "module_databases": "data/modules/<module_id>.db",
    "auto_update": "git fetch + fast-forward only when worktree is clean"
  },
  "update_protocol": {
    "required": true,
    "protocol": "docs/UPDATE_PROTOCOL.md",
    "journal": "UPDATE_LOG.md",
    "id_registry": "UPDATE_IDS.json",
    "agent_entrypoint": "AGENTS.md",
    "validator": "scripts/validate_update_protocol.py",
    "sequence": "task -> ID -> change -> check -> version -> journal -> commit -> next_action"
  },
  "versioning_policy": {
    "project_version": "SemVer",
    "rule": "Every released project change increments the project version.",
    "module_versions": "Each module owns an independent SemVer version."
  },
  "safety": {
    "no_hardcoded_drive_letter": true,
    "no_forced_git_reset": true,
    "no_update_over_local_changes": true,
    "bind_localhost_only": true
  },
  "next_action": "Complete CI for v0.1.1 update protocol, finalize the journal, then start v0.2.0 Module Runtime & Lifecycle."
}
